{
	"schemaVersion": 1,
	"id": "fastmine",
	"version": "${version}",
	"name": "FastMine",
	"description": "A Fabric mod that provides configurable vein mining and area mining.",
	"authors": [
		"TimHXL"
	],
	"contact": {
		"homepage": "https://github.com/TimHXL/FastMine",
		"sources": "https://github.com/TimHXL/FastMine",
		"issues": "https://github.com/TimHXL/FastMine/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/fastmine/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.timhxl.fastmine.FastMineMod"
		],
		"client": [
			"com.timhxl.fastmine.client.FastMineClient"
		]
	},
	"mixins": [
		"fastmine.mixins.json",
		{
			"config": "fastmine.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}